<Window x:Class="ImgViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ImgViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PhotographerEye"
        Height="800" Width="1200" MinHeight="440" MinWidth="980"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontSize="12"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDragLeave="OnPreviewDragLeave"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="26"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border x:Name="TitleBar"
                DockPanel.Dock="Top"
                Height="26"
                Background="#FF000000">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnWinMin" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinMinimizeClick" ToolTip="Minimize"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                    <Button x:Name="BtnWinMax" Content="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinMaximizeClick" ToolTip="Maximize"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                    <Button x:Name="BtnWinClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinCloseClick" ToolTip="Close"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12" />
            </DockPanel>
        </Border>

    <DockPanel>
        <Border x:Name="ToolbarBar"
                DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel x:Name="ToolbarDock">
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="BtnSettings" AutomationProperties.AutomationId="BtnSettings"
                            Content="&#xE713;"
                            Style="{StaticResource FlatButton}"
                            Click="OnSettingsClick"
                            ToolTip="Settings, plugins, export and view options" />
                    <Popup x:Name="SettingsFlyout"
                           PlacementTarget="{Binding ElementName=BtnSettings}"
                           Placement="Custom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Focusable="False">
                        <Border x:Name="SettingsFlyoutBody" AutomationProperties.AutomationId="SettingsFlyout"
                                Margin="10,4,10,14"
                                Padding="8,4,8,8"
                                Width="380"
                                CornerRadius="9"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushCol}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.55" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="PLUGINS" Style="{StaticResource FlyoutHeader}" />
                                <WrapPanel>
                                    <Button x:Name="TilePlugins" Content="&#xEA86;" Tag="Plugins…" Style="{StaticResource TileButton}" Click="OnPluginsClick"
                                            ToolTip="Install, switch on/off and remove plugins" />
                                    <Button x:Name="TileExport" Content="&#xEDE1;" Tag="Export" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Export the photo with a plugin exporter">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuExport" /></Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="TileCommands" Content="&#xE945;" Tag="Commands" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Commands added by plugins">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuCommands" /></Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="TileTools" Content="&#xE70F;" Tag="Tools" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Mouse tools on the photo from plugins (Esc switches the tool off)">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuPluginTools" /></Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="TilePluginSettings" Content="&#xE90F;" Tag="Plugin settings" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Settings of installed plugins">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuPluginSettings" /></Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="TileOverlays" Content="&#xE81E;" Tag="Overlays" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Information drawn over the photo by plugins">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuPluginOverlays" /></Button.ContextMenu>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="VIEW" Style="{StaticResource FlyoutHeader}" />
                                <WrapPanel>
                                    <Button x:Name="TileBackground" AutomationProperties.AutomationId="TileBackground" Content="&#xE790;" Tag="Background" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Surround of the photo (dark, black, neutral 18 % grey, light, white) and your own picture behind the adjustments panel">
                                        <Button.ContextMenu><ContextMenu x:Name="MnuBackground" Opened="OnBackgroundMenuOpened" /></Button.ContextMenu>
                                    </Button>
                                    <Button x:Name="TilePreviewQuality" Content="&#xE7B3;" Tag="Preview quality" Style="{StaticResource TileButton}" Click="OnTileMenuClick"
                                            ToolTip="Resolution of the live preview while editing RAW photos. Export always uses the full image.">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="MnuPreviewWindow" Header="Fast (window size)" IsCheckable="True" Tag="window" Click="OnPreviewQualityClick" />
                                                <MenuItem x:Name="MnuPreviewSharp" Header="Sharp (2× window size)" IsCheckable="True" Tag="sharp" Click="OnPreviewQualityClick" />
                                                <MenuItem x:Name="MnuPreviewFull" Header="Full resolution (slow)" IsCheckable="True" Tag="full" Click="OnPreviewQualityClick" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <ToggleButton x:Name="MnuRememberPreviews" Content="&#xE81C;" Tag="Remember previews" Style="{StaticResource TileToggle}" Click="OnRememberPreviewsClick"
                                                  ToolTip="Show the last rendered look of a photo at once when it is opened again, while the real render runs in the background." />
                                    <Button x:Name="TilePresentation" Content="&#xE740;" Tag="Presentation" Style="{StaticResource TileButton}" Click="OnPresentationClick"
                                            ToolTip="Full screen on black, no bars (F or F11; P starts a slideshow; Esc exits)" />
                                    <Button x:Name="TileClearCache" Content="&#xE74D;" Tag="Clear preview cache" Style="{StaticResource TileButton}" Click="OnClearPreviewCacheClick"
                                            ToolTip="Delete the remembered previews" />
                                </WrapPanel>
                                <TextBlock Text="EDITS &amp; APP" Style="{StaticResource FlyoutHeader}" />
                                <WrapPanel>
                                    <ToggleButton x:Name="MnuAutoSaveEdits" Content="&#xE78C;" Tag="Auto-save edits" Style="{StaticResource TileToggle}" Click="OnAutoSaveEditsClick"
                                                  ToolTip="Keep every edit in the photo's .eye file (_eye_ subfolder of the photo folder) as you work, so it is back after a restart. Off: edits are written only with Save Photo." />
                                    <Button x:Name="MnuAbout" Content="&#xE946;" Tag="About" Style="{StaticResource TileButton}" Click="OnAboutClick"
                                            ToolTip="Version and licences" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <WrapPanel>
                <Button x:Name="BtnOpen" Content="&#xED25;" Style="{StaticResource FlatButton}" Click="OnOpenClick" ToolTip="Open (Ctrl+O)" />
                <TextBlock x:Name="CounterText" VerticalAlignment="Center" Margin="4,0" MinWidth="52" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="&#x2013; / &#x2013;" />
                <Button x:Name="BtnSave" AutomationProperties.AutomationId="BtnSave" Content="&#xE74E;" IsEnabled="False"
                        Style="{StaticResource FlatButton}" Click="OnSaveClick" ToolTip="Save modified photo (Ctrl+S)" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BtnZoomOut" Content="&#xE71F;" Style="{StaticResource FlatButton}" Click="OnZoomOutClick" ToolTip="Zoom out (−)" />
                <Slider x:Name="ZoomSlider" Width="80" Margin="4,0" VerticalAlignment="Center" Minimum="0.1" Maximum="4" SmallChange="0.05" LargeChange="0.25" v:PhotoshopSlider.Enable="True" />
                <Button x:Name="BtnZoomIn" Content="&#xE8A3;" Style="{StaticResource FlatButton}" Click="OnZoomInClick" ToolTip="Zoom in (+)" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Margin="2,0" Foreground="{StaticResource MutedBrush}" Text="100 %" />
                <Button x:Name="BtnFit" Content="&#xE9A6;" Style="{StaticResource FlatButton}" Click="OnFitClick" ToolTip="Fit to window (0)" />
                <Button x:Name="Btn100" Content="1:1" Style="{StaticResource FlatTextButton}" Click="On100Click" ToolTip="Actual pixels, 100 % (1)" />

                <Border Style="{StaticResource ToolSeparator}" />

                <TextBlock Text="Shadows" Style="{StaticResource ToolLabel}" />
                <Slider x:Name="ShadowSlider" Width="90" VerticalAlignment="Center" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" v:PhotoshopSlider.Enable="True" />
                <TextBlock x:Name="ShadowValue" Width="40" Margin="5,0,0,0" VerticalAlignment="Center" Text="0" TextAlignment="Right" />

                <TextBlock Text="Gamma" Style="{StaticResource ToolLabel}" Margin="14,0,5,0" />
                <Slider x:Name="GammaSlider" Width="90" VerticalAlignment="Center" Minimum="0.5" Maximum="2" SmallChange="0.02" LargeChange="0.1" v:PhotoshopSlider.Enable="True" />
                <TextBlock x:Name="GammaValue" Width="40" Margin="5,0,0,0" VerticalAlignment="Center" Text="1.00" TextAlignment="Right" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BtnUndo" Content="&#xE7A7;" Style="{StaticResource FlatButton}" Click="OnUndoClick"
                        ToolTip="Undo last adjustment (Ctrl+Z)" />
                <Button x:Name="BtnRedo" Content="&#xE7A6;" Style="{StaticResource FlatButton}" Click="OnRedoClick"
                        ToolTip="Redo undone adjustment (Ctrl+Y)" />
                <Button x:Name="BtnReset" Content="&#xE777;" Style="{StaticResource FlatButton}" Click="OnResetClick"
                        ToolTip="Reset all adjustments" />
                <Button x:Name="BtnCompare" Content="&#xE89A;" Style="{StaticResource FlatButton}"
                        PreviewMouseLeftButtonDown="OnComparePress"
                        MouseLeftButtonUp="OnCompareRelease"
                        LostMouseCapture="OnCompareLostCapture"
                        ToolTip="Hold — view original without edits (Space)" />
                <Button x:Name="BtnMono" Content="&#xEA61;" Style="{StaticResource FlatButton}" Click="OnMonoToggleClick"
                        ToolTip="Black &amp; white: documentary / Tri-X 400 (B — three states)" />
                <StackPanel x:Name="PluginToolbarHost" Orientation="Horizontal" AutomationProperties.AutomationId="PluginToolbarHost" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BtnRotateL" AutomationProperties.AutomationId="BtnRotateL" Content="&#xE7AD;" Style="{StaticResource FlatButton}" Click="OnRotateLeftClick"
                        RenderTransformOrigin="0.5,0.5" ToolTip="Rotate left 90 degrees">
                    <Button.RenderTransform><ScaleTransform ScaleX="-1" /></Button.RenderTransform>
                </Button>
                <Button x:Name="BtnRotateR" AutomationProperties.AutomationId="BtnRotateR" Content="&#xE7AD;" Style="{StaticResource FlatButton}" Click="OnRotateRightClick"
                        ToolTip="Rotate right 90 degrees (swaps landscape/portrait)" />
                <Button x:Name="BtnCrop" AutomationProperties.AutomationId="BtnCrop" Content="&#xE7A8;" Style="{StaticResource FlatButton}" Click="OnCropClick"
                        ToolTip="Crop &amp; straighten (C) — drag inside: move, handles: resize, drag outside or Ctrl+drag: rotate, Esc: close" />
                <Button x:Name="BtnPanel" Content="&#xE9E9;" Style="{StaticResource FlatButton}" Click="OnPanelToggleClick"
                        ToolTip="Adjustments panel — exposure, contrast, white balance, saturation, clarity, dehaze, denoise (E)" />
                <Button x:Name="BtnPresent" Content="&#xE740;" Style="{StaticResource FlatButton}" Click="OnPresentationClick"
                        ToolTip="Presentation — full screen on black, no bars (F / F11; P slideshow; Esc exits)" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border x:Name="StatusBar"
                DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusRight" AutomationProperties.AutomationId="StatusRight" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="" />
                <TextBlock x:Name="StatusLeft" AutomationProperties.AutomationId="StatusLeft" Foreground="{StaticResource MutedBrush}" Text="Ready" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="ViewerHost" Grid.Column="0" Background="{StaticResource PanelBrushDark}" ClipToBounds="True">
            <Image x:Name="BgImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
            <Rectangle x:Name="BgDim" Fill="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" />
            <v:ImageViewer x:Name="Viewer" />
            <Button x:Name="BtnEdgeLeft"
                    Content="&#x2039;"
                    HorizontalAlignment="Left"
                    Margin="16,0,0,0"
                    Style="{StaticResource EdgeButton}"
                    Visibility="Collapsed"
                    Click="OnPrevClick"
                    ToolTip="Previous image (&#x2190;)" />
            <Button x:Name="BtnEdgeRight"
                    Content="&#x203A;"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0"
                    Style="{StaticResource EdgeButton}"
                    Visibility="Collapsed"
                    Click="OnNextClick"
                    ToolTip="Next image (&#x2192;)" />
            <v:CropOverlay x:Name="CropOverlay" Visibility="Collapsed" />
            <v:PluginOverlayCanvas x:Name="PluginOverlays" Visibility="Collapsed" />
            <v:PointMarkerOverlay x:Name="PointMarkers" Visibility="Collapsed" />
            <v:MaskOverlay x:Name="MaskOverlay" Visibility="Collapsed" />
            <Grid x:Name="HistHost"
                  Width="250" Height="130"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,10,10,0"
                  Visibility="Hidden">
                <Grid.Resources>
                    <Style x:Key="HistChanToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
                        <Setter Property="Height" Value="18" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Margin" Value="0,0,3,0" />
                        <Setter Property="Background" Value="#33000000" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#66FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <v:HistogramOverlay x:Name="HistogramPanel" />
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnHistRgb" Width="28" Content="RGB" IsChecked="True"
                                  Foreground="#ECECEC"
                                  Style="{StaticResource HistChanToggle}" Click="OnHistChannelClick"
                                  ToolTip="Edit brightness of all channels (luma stretch)" />
                    <ToggleButton x:Name="BtnHistR" Width="18" Content="R"
                                  Foreground="#FF6A6A"
                                  Style="{StaticResource HistChanToggle}" Click="OnHistChannelClick"
                                  ToolTip="Edit the red channel curve" />
                    <ToggleButton x:Name="BtnHistG" Width="18" Content="G"
                                  Foreground="#6AF06A"
                                  Style="{StaticResource HistChanToggle}" Click="OnHistChannelClick"
                                  ToolTip="Edit the green channel curve" />
                    <ToggleButton x:Name="BtnHistB" Width="18" Content="B"
                                  Foreground="#8A9AFF"
                                  Style="{StaticResource HistChanToggle}" Click="OnHistChannelClick"
                                  ToolTip="Edit the blue channel curve" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnHistBake"
                                  Width="18" Height="18"
                                  IsChecked="True"
                                  Content="&#xE8AB;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="10"
                                  Padding="0"
                                  MinWidth="0"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource ToolToggle}"
                                  ToolTip="Convert histogram drags into slider values (off — keep the drag as an independent curve)" />
                    <Button x:Name="BtnHistReset"
                            Width="18" Height="18"
                            Content="&#xE72C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Padding="0"
                            MinWidth="0"
                            Margin="0,0,4,0"
                            Style="{StaticResource ToolButton}"
                            Click="OnHistResetClick"
                            ToolTip="Remove histogram stretch points and R/G/B curves" />
                    <Button x:Name="BtnHistClose"
                            Width="18" Height="18"
                            Content="&#x2715;"
                            FontSize="10"
                            Padding="0"
                            MinWidth="0"
                            Style="{StaticResource ToolButton}"
                            Click="OnHistCloseClick"
                            ToolTip="Close histogram" />
                </StackPanel>
            </Grid>
            <!-- Welcome screen (no photo open): open buttons, drop zone, recent folders; the background picture shows behind it. -->
            <Grid x:Name="HintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Rectangle x:Name="DropZone" RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="5 4"
                           Stroke="#55FFFFFF" Fill="#99141519" IsHitTestVisible="False" />
                <StackPanel Margin="44,34,44,30" MaxWidth="520">
                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="PhotographerEye" FontSize="26" FontWeight="Light" Margin="0,10,0,0" Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Open a photo or a folder — or drop them here" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BtnWelcomeOpen" AutomationProperties.AutomationId="BtnWelcomeOpen" Style="{StaticResource WelcomeButton}" Click="OnOpenClick" ToolTip="Ctrl+O">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Open photo…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnWelcomeFolder" Style="{StaticResource WelcomeButton}" Margin="10,0,0,0" Click="OnOpenFolderClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Open folder…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="RecentSection" Margin="0,22,0,0" Visibility="Collapsed">
                        <TextBlock Text="RECENT FOLDERS" Style="{StaticResource FlyoutHeader}" />
                        <StackPanel x:Name="RecentList" />
                    </StackPanel>
                    <TextBlock Margin="0,20,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="←/→ next/previous · wheel zoom · 0 fit · 1 100 % · E adjustments · C crop&#x0a;F full-screen presentation · P slideshow · Ctrl+S save" />
                    <Button x:Name="BtnWelcomePicture" Style="{StaticResource FlatTextButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Foreground="{StaticResource MutedBrush}" FontSize="11" Click="OnWelcomePictureClick"
                            Content="Choose a background picture…" ToolTip="Your own picture behind this screen and behind the adjustments panel" />
                </StackPanel>
            </Grid>
            <!-- Presentation mode: short fading hint (keys, file name, slideshow state). -->
            <Border x:Name="PresentHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28"
                    Background="#B0000000" CornerRadius="16" Padding="16,7" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                <TextBlock x:Name="PresentHintText" Foreground="#E6E6E6" FontSize="13" TextAlignment="Center" />
            </Border>
            <Border x:Name="CropBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Background="#F026272D"
                    BorderBrush="{StaticResource BorderBrushCol}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aspect" Style="{StaticResource ToolLabel}" Margin="0,0,5,0" />
                    <ComboBox x:Name="CropAspectCombo" Width="100" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="CropAspectCombo"
                              SelectionChanged="OnCropAspectChanged">
                        <ComboBoxItem Content="Original" Tag="original" />
                        <ComboBoxItem Content="3:2" Tag="3:2" />
                        <ComboBoxItem Content="4:3" Tag="4:3" />
                        <ComboBoxItem Content="16:9" Tag="16:9" />
                        <ComboBoxItem Content="16:10" Tag="16:10" />
                    </ComboBox>
                    <Button x:Name="BtnCropReset" AutomationProperties.AutomationId="BtnCropReset" Content="Original frame" Margin="10,0,0,0" Style="{StaticResource ToolButton}"
                            Click="OnCropResetClick"
                            ToolTip="Back to original aspect and full size (removes crop and straighten)" />
                    <Button x:Name="BtnCropDone" AutomationProperties.AutomationId="BtnCropDone" Content="Done" Margin="6,0,0,0" Style="{StaticResource ToolButton}"
                            Click="OnCropDoneClick"
                            ToolTip="Close crop mode (Esc)" />
                </StackPanel>
            </Border>
            <Border x:Name="MaskBar"
                    AutomationProperties.AutomationId="MaskBar"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,14"
                    Background="#F026272D"
                    BorderBrush="{StaticResource BorderBrushCol}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="MaskBarText" Style="{StaticResource ToolLabel}" />
                        <TextBlock x:Name="MaskBarHint" Style="{StaticResource ToolLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0" />
                        <TextBlock x:Name="MaskBarShared" AutomationProperties.AutomationId="MaskBarShared" Style="{StaticResource ToolLabel}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,1,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="BtnMaskOnlyHere" AutomationProperties.AutomationId="BtnMaskOnlyHere" Style="{StaticResource ToolButton}"
                            Padding="8,1,8,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="OnMaskOnlyHereClick" />
                    <ToggleButton x:Name="BtnMaskTint" AutomationProperties.AutomationId="BtnMaskTint" Content="Overlay" IsChecked="True" Style="{StaticResource ToolToggle}"
                                  Padding="8,1,8,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                  Click="OnMaskTintClick"
                                  ToolTip="Show the red overlay of the selected area (off: see the result while editing)" />
                    <Button x:Name="BtnMaskDone" AutomationProperties.AutomationId="BtnMaskDone" Content="Done" Style="{StaticResource ToolButton}"
                            Click="OnMaskDoneClick"
                            ToolTip="Finish editing the mask (Esc or Enter); the mask stays applied" />
                </StackPanel>
            </Border>
             </Grid>

             <Border Grid.Column="1" x:Name="RightPanel"
                     Width="256"
                     Visibility="Collapsed"
                     Background="{StaticResource PanelBrush}"
                     BorderBrush="{StaticResource BorderBrushCol}"
                     BorderThickness="1,0,0,0">
                 <Grid ClipToBounds="True">
                 <!-- Optional picture behind the adjustments (⚙ → Background), blurred and darkened for legibility. -->
                 <Image x:Name="PanelBgImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                 <Rectangle x:Name="PanelBgDim" Fill="Black" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed" />
                 <DockPanel>
                     <Border DockPanel.Dock="Top"
                             BorderBrush="{StaticResource BorderBrushCol}"
                             BorderThickness="0,0,0,1"
                             Padding="10,6">
                         <DockPanel>
                             <Button x:Name="BtnPanelReset"
                                     DockPanel.Dock="Right"
                                     Width="18" Height="18"
                                     Content="&#xE72C;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Padding="0"
                                     MinWidth="0"
                                     Style="{StaticResource ToolButton}"
                                     Click="OnResetClick"
                                     ToolTip="Reset all edits" />
                             <Button x:Name="BtnPresets"
                                     AutomationProperties.AutomationId="BtnPresets"
                                     DockPanel.Dock="Right"
                                     Height="18"
                                     Margin="0,0,6,0"
                                     Padding="6,0"
                                     MinWidth="0"
                                     FontSize="11"
                                     Content="Presets"
                                     Style="{StaticResource ToolButton}"
                                     Click="OnPresetsClick"
                                     ToolTip="Apply, save or delete presets" />
                             <TextBlock Text="Adjustments" FontWeight="SemiBold" VerticalAlignment="Center" />
                         </DockPanel>
                     </Border>
                     <ScrollViewer VerticalScrollBarVisibility="Auto">
                         <!-- Handled on the content, not the ScrollViewer: its class handler would scroll before an instance handler runs. -->
                         <StackPanel Margin="12,8,12,12" RequestBringIntoView="OnPanelRequestBringIntoView">
                          <StackPanel x:Name="AdjMaskHost" AutomationProperties.AutomationId="AdjMaskHost" />
                          <StackPanel x:Name="StdSectionBody" AutomationProperties.AutomationId="StdSectionBody">
                          <StackPanel Margin="0,8,0,0">
                              <Grid>
                                  <TextBlock Text="Exposure" />
                                  <TextBlock x:Name="ExpValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0.00" />
                              </Grid>
                              <Slider x:Name="ExpSlider" Minimum="-5" Maximum="5" SmallChange="0.05" LargeChange="0.25" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Contrast" />
                                  <TextBlock x:Name="ContrastValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Highlights" />
                                  <TextBlock x:Name="HighlightsValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Shadows" />
                                  <TextBlock x:Name="PanelShadowValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="PanelShadowSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Whites" />
                                  <TextBlock x:Name="WhitesValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Blacks" />
                                  <TextBlock x:Name="BlacksValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="White balance" />
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                      <Button x:Name="BtnWbPicker"
                                              Width="18" Height="18"
                                              Content="&#xE790;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Padding="0"
                                              MinWidth="0"
                                              Margin="0,0,6,0"
                                              Style="{StaticResource ToolButton}"
                                              Click="OnWbPickerClick"
                                              ToolTip="White point — click a neutral area of the photo (eyedropper)" />
                                      <TextBlock x:Name="TempValue" Foreground="{StaticResource MutedBrush}" Text="0" />
                                  </StackPanel>
                              </Grid>
                              <Slider x:Name="TempSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True"
                                      ToolTip="Temperature: − cooler (blue), + warmer (amber). Fine near 0, wide range towards the ends" />
                              <Grid Margin="0,8,0,0">
                                  <TextBlock Text="Tint" Foreground="{StaticResource MutedBrush}" />
                                  <TextBlock x:Name="TintValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="TintSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True"
                                      ToolTip="Tint: − green, + magenta (fluorescent / LED light)" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Clarity" />
                                  <TextBlock x:Name="ClarityValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ClaritySlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Saturation" />
                                  <TextBlock x:Name="SatValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="SatSlider" Value="0" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          </StackPanel>
                          <StackPanel x:Name="DetailSectionBody" AutomationProperties.AutomationId="DetailSectionBody">
                          <StackPanel Margin="0,8,0,0">
                              <Grid>
                                  <TextBlock Text="Sharpening" />
                                  <TextBlock x:Name="SharpenValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="SharpenSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Dehaze" />
                                  <TextBlock x:Name="DehazeValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="DehazeSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Noise reduction" ToolTip="Removes luminance grain; strength adapts to the noise measured in the photo, edges and texture are kept" />
                                  <TextBlock x:Name="DenoiseValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Color noise reduction" ToolTip="Removes colored speckles and color blotches; brightness detail is not affected" />
                                  <TextBlock x:Name="ColorNoiseValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ColorNoiseSlider" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          </StackPanel>
                          <StackPanel x:Name="PluginPanelHost" AutomationProperties.AutomationId="PluginPanelHost" />
                         </StackPanel>
                     </ScrollViewer>
                 </DockPanel>
                 </Grid>
             </Border>
         </Grid>
     </DockPanel>
     </DockPanel>
 </Window>