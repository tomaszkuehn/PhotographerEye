<Window x:Class="ImgViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ImgViewer.Controls"
        Title="ImgViewer"
        Height="800" Width="1200" MinHeight="440" MinWidth="640"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontSize="13"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <WrapPanel>
                <Button x:Name="BtnOpen" Content="Otwórz" Style="{StaticResource ToolButton}" Click="OnOpenClick" />

                <Button x:Name="BtnPrev" Content="&#x2039;" FontSize="17" Padding="9,3" Style="{StaticResource ToolButton}" Click="OnPrevClick" />
                <TextBlock x:Name="CounterText" VerticalAlignment="Center" Margin="8,0" MinWidth="64" TextAlignment="Center" Text="&#x2013; / &#x2013;" />
                <Button x:Name="BtnNext" Content="&#x203A;" FontSize="17" Padding="9,3" Style="{StaticResource ToolButton}" Click="OnNextClick" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BtnZoomOut" Content="&#x2212;" Style="{StaticResource ToolButton}" Click="OnZoomOutClick" />
                <Slider x:Name="ZoomSlider" Width="160" Margin="8,0" VerticalAlignment="Center" Minimum="0.1" Maximum="4" SmallChange="0.05" LargeChange="0.25" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" MinWidth="54" TextAlignment="Right" Margin="0,0,6,0" Text="100 %" />
                <Button x:Name="BtnZoomIn" Content="+" Style="{StaticResource ToolButton}" Click="OnZoomInClick" />
                <Button x:Name="BtnFit" Content="Dopasuj" Margin="8,0,0,0" Style="{StaticResource ToolButton}" Click="OnFitClick" />
                <Button x:Name="Btn100" Content="100 %" Margin="6,0,0,0" Style="{StaticResource ToolButton}" Click="On100Click" />

                <Border Style="{StaticResource ToolSeparator}" />

                <TextBlock Text="Cienie" Style="{StaticResource ToolLabel}" />
                <Slider x:Name="ShadowSlider" Width="130" VerticalAlignment="Center" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" />
                <TextBlock x:Name="ShadowValue" Width="42" Margin="7,0,0,0" VerticalAlignment="Center" Text="0 %" TextAlignment="Right" />

                <TextBlock Text="Gamma" Style="{StaticResource ToolLabel}" />
                <Slider x:Name="GammaSlider" Width="130" VerticalAlignment="Center" Minimum="0.5" Maximum="2" SmallChange="0.02" LargeChange="0.1" />
                <TextBlock x:Name="GammaValue" Width="42" Margin="7,0,0,0" VerticalAlignment="Center" Text="1.00" TextAlignment="Right" />

                <Button x:Name="BtnReset" Content="Reset" Margin="12,0,0,0" Style="{StaticResource ToolButton}" Click="OnResetClick" />
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="" />
                <TextBlock x:Name="StatusLeft" Foreground="{StaticResource MutedBrush}" Text="Gotowy" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid Background="{StaticResource PanelBrushDark}">
            <v:ImageViewer x:Name="Viewer" />
            <Border x:Name="HintPanel"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Otwórz obraz" FontSize="22" Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               Text="Ctrl+O — dialog Otwórz, przeciągnij plik z Eksploratora;&#x0a;strzałki &#x2039;/&#x203A; — następny/poprzedni, Ctrl+rolka — zoom, przeciągnij myszką — przesuwanie;&#x0a;1 — 100 %, 0 — dopasuj, R — reset korekt (podwójny klik na suwak — wartość domyślna)" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>