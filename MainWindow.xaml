<Window x:Class="ImgViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ImgViewer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PhotographerEye"
        Height="800" Width="1200" MinHeight="440" MinWidth="980"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        FontSize="12"
        Icon="pack://application:,,,/Assets/icon.ico"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragOver="OnPreviewDragOver"
        Drop="OnDrop"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="26"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="26"
                Background="#FF000000">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnWinMin" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinMinimizeClick" ToolTip="Minimize"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                    <Button x:Name="BtnWinMax" Content="&#xE739;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinMaximizeClick" ToolTip="Maximize"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                    <Button x:Name="BtnWinClose" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Width="34" Height="26" Click="OnWinCloseClick" ToolTip="Close"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}" />
                </StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           FontSize="12" />
            </DockPanel>
        </Border>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel x:Name="ToolbarDock">
                <Button x:Name="BtnSettings"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Width="30" Height="26"
                        Margin="8,0,0,0"
                        Style="{StaticResource ToolButton}"
                        Click="OnSettingsClick"
                        ToolTip="Settings">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" StaysOpen="False">
                            <MenuItem x:Name="MnuAbout" Header="About…" Click="OnAboutClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <WrapPanel>
                <Button x:Name="BtnOpen" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26"
                        Style="{StaticResource ToolButton}" Click="OnOpenClick" ToolTip="Open (Ctrl+O)" />

                <TextBlock x:Name="CounterText" VerticalAlignment="Center" Margin="5,0" MinWidth="52" TextAlignment="Center" Text="&#x2013; / &#x2013;" />
                <Button x:Name="BtnSave" Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26" IsEnabled="False"
                        Style="{StaticResource ToolButton}" Click="OnSaveClick" ToolTip="Save modified photo (Ctrl+S)" />

                <Border Style="{StaticResource ToolSeparator}" />

                <Button x:Name="BtnZoomOut" Content="&#x2212;" Style="{StaticResource ToolButton}" Click="OnZoomOutClick" />
                <Slider x:Name="ZoomSlider" Width="80" Margin="6,0" VerticalAlignment="Center" Minimum="0.1" Maximum="4" SmallChange="0.05" LargeChange="0.25" v:PhotoshopSlider.Enable="True" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" MinWidth="46" TextAlignment="Right" Margin="0,0,4,0" Text="100 %" />
                <Button x:Name="BtnZoomIn" Content="+" Style="{StaticResource ToolButton}" Click="OnZoomInClick" />
                <Button x:Name="BtnFit" Content="&#xE9A9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}" Click="OnFitClick" ToolTip="Fit to window (0)" />
                <Button x:Name="Btn100" Content="100 %" Margin="5,0,0,0" Style="{StaticResource ToolButton}" Click="On100Click" />

                <Border Style="{StaticResource ToolSeparator}" />

                <TextBlock Text="Shadows" Style="{StaticResource ToolLabel}" />
                <Slider x:Name="ShadowSlider" Width="90" VerticalAlignment="Center" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" v:PhotoshopSlider.Enable="True" />
                <TextBlock x:Name="ShadowValue" Width="48" Margin="5,0,0,0" VerticalAlignment="Center" Text="0" TextAlignment="Right" />

                <TextBlock Text="Gamma" Style="{StaticResource ToolLabel}" />
                <Slider x:Name="GammaSlider" Width="90" VerticalAlignment="Center" Minimum="0.5" Maximum="2" SmallChange="0.02" LargeChange="0.1" v:PhotoshopSlider.Enable="True" />
                <TextBlock x:Name="GammaValue" Width="48" Margin="5,0,0,0" VerticalAlignment="Center" Text="1.00" TextAlignment="Right" />

                <Button x:Name="BtnUndo" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}" Click="OnUndoClick"
                        ToolTip="Undo last adjustment (Ctrl+Z)" />
                <Button x:Name="BtnRedo" Content="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}" Click="OnRedoClick"
                        ToolTip="Redo undone adjustment (Ctrl+Y)" />
                <Button x:Name="BtnReset" Content="Reset" Margin="8,0,0,0" Style="{StaticResource ToolButton}" Click="OnResetClick" />
                <Button x:Name="BtnCompare" Content="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}"
                        PreviewMouseLeftButtonDown="OnComparePress"
                        MouseLeftButtonUp="OnCompareRelease"
                        LostMouseCapture="OnCompareLostCapture"
                        ToolTip="Hold — view original without edits (Space)" />
                <Button x:Name="BtnMono" Content="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}" Click="OnMonoToggleClick"
                        ToolTip="Black &amp; white: documentary / Tri-X 400 (B — three states)" />
                <Button x:Name="BtnPanel" Content="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="30" Height="26" Margin="6,0,0,0"
                        Style="{StaticResource ToolButton}" Click="OnPanelToggleClick"
                        ToolTip="Adjustments panel — exposure, contrast, white balance, saturation, clarity, dehaze, denoise (E)" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushCol}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="" />
                <TextBlock x:Name="StatusLeft" Foreground="{StaticResource MutedBrush}" Text="Ready" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="{StaticResource PanelBrushDark}">
            <v:ImageViewer x:Name="Viewer" />
            <Button x:Name="BtnEdgeLeft"
                    Content="&#x2039;"
                    HorizontalAlignment="Left"
                    Margin="16,0,0,0"
                    Style="{StaticResource EdgeButton}"
                    Visibility="Collapsed"
                    Click="OnPrevClick"
                    ToolTip="Previous image (&#x2190;)" />
            <Button x:Name="BtnEdgeRight"
                    Content="&#x203A;"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,0"
                    Style="{StaticResource EdgeButton}"
                    Visibility="Collapsed"
                    Click="OnNextClick"
                    ToolTip="Next image (&#x2192;)" />
            <Grid x:Name="HistHost"
                  Width="250" Height="130"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,10,10,0"
                  Visibility="Hidden">
                <v:HistogramOverlay x:Name="HistogramPanel" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Orientation="Horizontal">
                    <ToggleButton x:Name="BtnHistBake"
                                  Width="18" Height="18"
                                  IsChecked="True"
                                  Content="&#xE8AB;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="10"
                                  Padding="0"
                                  MinWidth="0"
                                  Margin="0,0,4,0"
                                  Style="{StaticResource ToolToggle}"
                                  ToolTip="Convert histogram drags into slider values (off — keep the drag as an independent curve)" />
                    <Button x:Name="BtnHistReset"
                            Width="18" Height="18"
                            Content="&#xE72C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Padding="0"
                            MinWidth="0"
                            Margin="0,0,4,0"
                            Style="{StaticResource ToolButton}"
                            Click="OnHistResetClick"
                            ToolTip="Remove histogram stretch points" />
                    <Button x:Name="BtnHistClose"
                            Width="18" Height="18"
                            Content="&#x2715;"
                            FontSize="10"
                            Padding="0"
                            MinWidth="0"
                            Style="{StaticResource ToolButton}"
                            Click="OnHistCloseClick"
                            ToolTip="Close histogram" />
                </StackPanel>
            </Grid>
            <Border x:Name="HintPanel"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Open an image" FontSize="22" Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                Text="Ctrl+O — open dialog, or drag a file from Explorer;&#x0a;←/→ arrows — next/previous, mouse wheel — zoom, drag — pan;&#x0a;1 — 100 %, 0 — fit, R — reset edits, E — adjustments panel, Ctrl+S — save modified photo" TextAlignment="Center" />
                 </StackPanel>
             </Border>
             </Grid>

             <Border Grid.Column="1" x:Name="RightPanel"
                     Width="256"
                     Visibility="Collapsed"
                     Background="{StaticResource PanelBrush}"
                     BorderBrush="{StaticResource BorderBrushCol}"
                     BorderThickness="1,0,0,0">
                 <DockPanel>
                     <Border DockPanel.Dock="Top"
                             BorderBrush="{StaticResource BorderBrushCol}"
                             BorderThickness="0,0,0,1"
                             Padding="10,6">
                         <DockPanel>
                             <Button x:Name="BtnPanelReset"
                                     DockPanel.Dock="Right"
                                     Width="18" Height="18"
                                     Content="&#xE72C;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="10"
                                     Padding="0"
                                     MinWidth="0"
                                     Style="{StaticResource ToolButton}"
                                     Click="OnResetClick"
                                     ToolTip="Reset all edits" />
                             <TextBlock Text="Adjustments" FontWeight="SemiBold" VerticalAlignment="Center" />
                         </DockPanel>
                     </Border>
                     <ScrollViewer VerticalScrollBarVisibility="Auto">
                         <StackPanel Margin="12,8,12,12">
                          <StackPanel Margin="0,2,0,0">
                              <Grid>
                                  <TextBlock Text="Exposure" />
                                  <TextBlock x:Name="ExpValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0.00" />
                              </Grid>
                              <Slider x:Name="ExpSlider" Minimum="-5" Maximum="5" SmallChange="0.05" LargeChange="0.25" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Contrast" />
                                  <TextBlock x:Name="ContrastValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Highlights" />
                                  <TextBlock x:Name="HighlightsValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Shadows" />
                                  <TextBlock x:Name="PanelShadowValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="PanelShadowSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Whites" />
                                  <TextBlock x:Name="WhitesValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="WhitesSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Blacks" />
                                  <TextBlock x:Name="BlacksValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="BlacksSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="White balance" />
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                      <Button x:Name="BtnWbPicker"
                                              Width="18" Height="18"
                                              Content="&#xE790;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="10"
                                              Padding="0"
                                              MinWidth="0"
                                              Margin="0,0,6,0"
                                              Style="{StaticResource ToolButton}"
                                              Click="OnWbPickerClick"
                                              ToolTip="White point — click a neutral area of the photo (eyedropper)" />
                                      <TextBlock x:Name="TempValue" Foreground="{StaticResource MutedBrush}" Text="0" />
                                  </StackPanel>
                              </Grid>
                              <Slider x:Name="TempSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Clarity" />
                                  <TextBlock x:Name="ClarityValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ClaritySlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Saturation" />
                                  <TextBlock x:Name="SatValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="SatSlider" Value="0" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Sharpening" />
                                  <TextBlock x:Name="SharpenValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="SharpenSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Dehaze" />
                                  <TextBlock x:Name="DehazeValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="DehazeSlider" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Denoise" />
                                  <TextBlock x:Name="DenoiseValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="DenoiseSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                              <Grid>
                                  <TextBlock Text="Color noise reduction" />
                                  <TextBlock x:Name="ColorNoiseValue" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Text="0" />
                              </Grid>
                              <Slider x:Name="ColorNoiseSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Margin="0,4,0,0" v:PhotoshopSlider.Enable="True" />
                          </StackPanel>
                         </StackPanel>
                     </ScrollViewer>
                 </DockPanel>
             </Border>
         </Grid>
     </DockPanel>
     </DockPanel>
 </Window>