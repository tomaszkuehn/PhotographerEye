<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ImgViewer.Plugins.BwRed</RootNamespace>
    <AssemblyName>ImgViewer.Plugins.BwRed</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PluginSdk\ImgViewer.Plugin.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <!-- Distributable package: bin\<cfg>\ImgViewer.Plugins.BwRed.pepkg (zip with manifest.json + the assembly). -->
  <Target Name="PackPepkg" AfterTargets="Build">
    <PropertyGroup>
      <PepkgStage>$(BaseIntermediateOutputPath)pepkg\</PepkgStage>
      <PepkgFile>$(OutDir)..\ImgViewer.Plugins.BwRed.pepkg</PepkgFile>
    </PropertyGroup>
    <RemoveDir Directories="$(PepkgStage)" />
    <Copy SourceFiles="$(TargetPath);manifest.json" DestinationFolder="$(PepkgStage)" />
    <ZipDirectory SourceDirectory="$(PepkgStage)" DestinationFile="$(PepkgFile)" Overwrite="true" />
  </Target>

</Project>
