<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(Win7)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Win7)' == 'true'">net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ImgViewer</RootNamespace>
    <AssemblyName>PhotographerEye</AssemblyName>
    <AssemblyTitle>PhotographerEye</AssemblyTitle>
    <Product>PhotographerEye</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.00</Version>
    <NeutralLanguage>pl-PL</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Win7)' == 'true'">$(DefineConstants);PHOTOGRAPHEREYE_NO_GPU</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" Condition="'$(Win7)' != 'true'" />
    <PackageReference Include="LibHeif.Native.win-x64" Version="1.15.1" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="PluginSdk\**" />
    <Compile Remove="eyePlugins\**" />
    <Resource Include="Assets\icon.ico" />
    <None Include="thirdparty\libraw22\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="thirdparty\librawhe\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PluginSdk\ImgViewer.Plugin.Abstractions.csproj" />
    <!-- Bundled plugins: built together with the app so they are never stale; not referenced by the app code. -->
    <ProjectReference Include="eyePlugins\auto\ImgViewer.Plugins.AutoEnhance.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\colorbalance\ImgViewer.Plugins.ColorBalance.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\heal\ImgViewer.Plugins.Heal.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\negative\ImgViewer.Plugins.Negative.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\bwred\ImgViewer.Plugins.BwRed.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\splittone\ImgViewer.Plugins.SplitTone.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\vignette\ImgViewer.Plugins.Vignette.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\netpbm\ImgViewer.Plugins.Netpbm.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\webexport\ImgViewer.Plugins.WebExport.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\exposure\ImgViewer.Plugins.ExposureInfo.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\sky\ImgViewer.Plugins.SkyMask.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="eyePlugins\eventlog\ImgViewer.Plugins.EventLog.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Each bundled plugin ships as plugins\<Folder>\{manifest.json, <Asm>.dll}. -->
  <ItemGroup>
    <BundledPlugin Include="autoenhance" Src="eyePlugins\auto" Asm="ImgViewer.Plugins.AutoEnhance" />
    <BundledPlugin Include="colorbalance" Src="eyePlugins\colorbalance" Asm="ImgViewer.Plugins.ColorBalance" />
    <BundledPlugin Include="heal" Src="eyePlugins\heal" Asm="ImgViewer.Plugins.Heal" />
    <BundledPlugin Include="negative" Src="eyePlugins\negative" Asm="ImgViewer.Plugins.Negative" />
    <BundledPlugin Include="bwred" Src="eyePlugins\bwred" Asm="ImgViewer.Plugins.BwRed" />
    <BundledPlugin Include="splittone" Src="eyePlugins\splittone" Asm="ImgViewer.Plugins.SplitTone" />
    <BundledPlugin Include="vignette" Src="eyePlugins\vignette" Asm="ImgViewer.Plugins.Vignette" />
    <BundledPlugin Include="netpbm" Src="eyePlugins\netpbm" Asm="ImgViewer.Plugins.Netpbm" />
    <BundledPlugin Include="webexport" Src="eyePlugins\webexport" Asm="ImgViewer.Plugins.WebExport" />
    <BundledPlugin Include="exposure" Src="eyePlugins\exposure" Asm="ImgViewer.Plugins.ExposureInfo" />
    <BundledPlugin Include="sky" Src="eyePlugins\sky" Asm="ImgViewer.Plugins.SkyMask" />
    <BundledPlugin Include="eventlog" Src="eyePlugins\eventlog" Asm="ImgViewer.Plugins.EventLog" />
  </ItemGroup>

  <Target Name="CopyLibRaw22ToPublish" AfterTargets="Publish">
    <Copy SourceFiles="thirdparty\libraw22\dcraw_emu.exe;thirdparty\libraw22\libraw.dll" DestinationFolder="$(PublishDir)thirdparty\libraw22" SkipUnchangedFiles="true" />
    <Copy SourceFiles="thirdparty\librawhe\dcraw_emu.exe" DestinationFolder="$(PublishDir)thirdparty\librawhe" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_BundledPluginFile Include="%(BundledPlugin.Src)\bin\$(Configuration)\netstandard2.0\%(BundledPlugin.Asm).dll;%(BundledPlugin.Src)\manifest.json" Folder="%(BundledPlugin.Identity)" />
      <_BundledPluginFile Remove="@(_BundledPluginFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(PublishDir)plugins\%(Folder)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Older layouts: all samples in plugins\samples, plugin dlls loose in plugins\. -->
    <RemoveDir Directories="$(PublishDir)plugins\samples" ContinueOnError="true" />
    <Delete Files="$(PublishDir)plugins\ImgViewer.Plugins.Samples.dll;$(PublishDir)plugins\ImgViewer.Plugins.AutoEnhance.dll" ContinueOnError="true" />
  </Target>

  <Target Name="CopyBundledPluginsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_BundledPluginFile Include="%(BundledPlugin.Src)\bin\$(Configuration)\netstandard2.0\%(BundledPlugin.Asm).dll;%(BundledPlugin.Src)\manifest.json" Folder="%(BundledPlugin.Identity)" />
      <_BundledPluginFile Remove="@(_BundledPluginFile)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundledPluginFile)" DestinationFiles="@(_BundledPluginFile->'$(OutDir)plugins\%(Folder)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <RemoveDir Directories="$(OutDir)plugins\samples" ContinueOnError="true" />
    <Delete Files="$(OutDir)plugins\ImgViewer.Plugins.Samples.dll;$(OutDir)plugins\ImgViewer.Plugins.AutoEnhance.dll" ContinueOnError="true" />
  </Target>

</Project>
