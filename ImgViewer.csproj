<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(Win7)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Win7)' == 'true'">net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ImgViewer</RootNamespace>
    <AssemblyName>PhotographerEye</AssemblyName>
    <AssemblyTitle>PhotographerEye</AssemblyTitle>
    <Product>PhotographerEye</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.00</Version>
    <NeutralLanguage>pl-PL</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Win7)' == 'true'">$(DefineConstants);PHOTOGRAPHEREYE_NO_GPU</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" Condition="'$(Win7)' != 'true'" />
    <PackageReference Include="LibHeif.Native.win-x64" Version="1.15.1" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="PluginSdk\**" />
    <Compile Remove="plugins-samples\**" />
    <Compile Remove="plugins-auto\**" />
    <Compile Remove="plugins-colorbalance\**" />
    <Compile Remove="plugins-heal\**" />
    <Resource Include="Assets\icon.ico" />
    <None Include="thirdparty\libraw22\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="thirdparty\librawhe\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PluginSdk\ImgViewer.Plugin.Abstractions.csproj" />
    <!-- Built together with the app so the bundled sample plugins are never stale; not referenced by the app code. -->
    <ProjectReference Include="plugins-samples\ImgViewer.Plugins.Samples.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins-auto\ImgViewer.Plugins.AutoEnhance.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins-colorbalance\ImgViewer.Plugins.ColorBalance.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins-heal\ImgViewer.Plugins.Heal.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <PluginSamplesBin>plugins-samples\bin\$(Configuration)\netstandard2.0\</PluginSamplesBin>
    <PluginAutoBin>plugins-auto\bin\$(Configuration)\netstandard2.0\</PluginAutoBin>
    <PluginCbBin>plugins-colorbalance\bin\$(Configuration)\netstandard2.0\</PluginCbBin>
    <PluginHealBin>plugins-heal\bin\$(Configuration)\netstandard2.0\</PluginHealBin>
  </PropertyGroup>

  <Target Name="CopyLibRaw22ToPublish" AfterTargets="Publish">
    <Copy SourceFiles="thirdparty\libraw22\dcraw_emu.exe;thirdparty\libraw22\libraw.dll" DestinationFolder="$(PublishDir)thirdparty\libraw22" SkipUnchangedFiles="true" />
    <Copy SourceFiles="thirdparty\librawhe\dcraw_emu.exe" DestinationFolder="$(PublishDir)thirdparty\librawhe" SkipUnchangedFiles="true" />
  </Target>

  <!-- Sample plugins ship as an installed package folder: plugins\samples\{manifest.json, ImgViewer.Plugins.Samples.dll}. -->
  <Target Name="CopyPluginSamplesToPublish" AfterTargets="Publish">
    <ItemGroup Condition="Exists('$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll')">
      <PluginSampleBin Include="$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll;plugins-samples\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginSampleBin)" DestinationFolder="$(PublishDir)plugins\samples" SkipUnchangedFiles="true" Condition="@(PluginSampleBin->Count()) &gt; 0" />
    <Delete Files="$(PublishDir)plugins\ImgViewer.Plugins.Samples.dll" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPluginSamplesToOutput" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll')">
      <PluginSampleBin Include="$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll;plugins-samples\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginSampleBin)" DestinationFolder="$(OutDir)plugins\samples" SkipUnchangedFiles="true" Condition="@(PluginSampleBin->Count()) &gt; 0" />
    <Delete Files="$(OutDir)plugins\ImgViewer.Plugins.Samples.dll" ContinueOnError="true" />
  </Target>

  <!-- Auto enhance plugin ships as plugins\autoenhance\{manifest.json, ImgViewer.Plugins.AutoEnhance.dll}. -->
  <Target Name="CopyPluginAutoToPublish" AfterTargets="Publish">
    <ItemGroup Condition="Exists('$(PluginAutoBin)ImgViewer.Plugins.AutoEnhance.dll')">
      <PluginAutoFile Include="$(PluginAutoBin)ImgViewer.Plugins.AutoEnhance.dll;plugins-auto\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginAutoFile)" DestinationFolder="$(PublishDir)plugins\autoenhance" SkipUnchangedFiles="true" Condition="@(PluginAutoFile->Count()) &gt; 0" />
    <Delete Files="$(PublishDir)plugins\ImgViewer.Plugins.AutoEnhance.dll" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPluginAutoToOutput" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(PluginAutoBin)ImgViewer.Plugins.AutoEnhance.dll')">
      <PluginAutoFile Include="$(PluginAutoBin)ImgViewer.Plugins.AutoEnhance.dll;plugins-auto\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginAutoFile)" DestinationFolder="$(OutDir)plugins\autoenhance" SkipUnchangedFiles="true" Condition="@(PluginAutoFile->Count()) &gt; 0" />
    <Delete Files="$(OutDir)plugins\ImgViewer.Plugins.AutoEnhance.dll" ContinueOnError="true" />
  </Target>

  <!-- Color balance plugin ships as plugins\colorbalance\{manifest.json, ImgViewer.Plugins.ColorBalance.dll}. -->
  <Target Name="CopyPluginCbToPublish" AfterTargets="Publish">
    <ItemGroup Condition="Exists('$(PluginCbBin)ImgViewer.Plugins.ColorBalance.dll')">
      <PluginCbFile Include="$(PluginCbBin)ImgViewer.Plugins.ColorBalance.dll;plugins-colorbalance\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginCbFile)" DestinationFolder="$(PublishDir)plugins\colorbalance" SkipUnchangedFiles="true" Condition="@(PluginCbFile->Count()) &gt; 0" />
  </Target>

  <Target Name="CopyPluginCbToOutput" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(PluginCbBin)ImgViewer.Plugins.ColorBalance.dll')">
      <PluginCbFile Include="$(PluginCbBin)ImgViewer.Plugins.ColorBalance.dll;plugins-colorbalance\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginCbFile)" DestinationFolder="$(OutDir)plugins\colorbalance" SkipUnchangedFiles="true" Condition="@(PluginCbFile->Count()) &gt; 0" />
  </Target>

  <!-- Heal plugin ships as plugins\heal\{manifest.json, ImgViewer.Plugins.Heal.dll}. -->
  <Target Name="CopyPluginHealToPublish" AfterTargets="Publish">
    <ItemGroup Condition="Exists('$(PluginHealBin)ImgViewer.Plugins.Heal.dll')">
      <PluginHealFile Include="$(PluginHealBin)ImgViewer.Plugins.Heal.dll;plugins-heal\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginHealFile)" DestinationFolder="$(PublishDir)plugins\heal" SkipUnchangedFiles="true" Condition="@(PluginHealFile->Count()) &gt; 0" />
  </Target>

  <Target Name="CopyPluginHealToOutput" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(PluginHealBin)ImgViewer.Plugins.Heal.dll')">
      <PluginHealFile Include="$(PluginHealBin)ImgViewer.Plugins.Heal.dll;plugins-heal\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginHealFile)" DestinationFolder="$(OutDir)plugins\heal" SkipUnchangedFiles="true" Condition="@(PluginHealFile->Count()) &gt; 0" />
  </Target>

</Project>
