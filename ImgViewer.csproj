<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(Win7)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(Win7)' == 'true'">net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ImgViewer</RootNamespace>
    <AssemblyName>PhotographerEye</AssemblyName>
    <AssemblyTitle>PhotographerEye</AssemblyTitle>
    <Product>PhotographerEye</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.00</Version>
    <NeutralLanguage>pl-PL</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(Win7)' == 'true'">$(DefineConstants);PHOTOGRAPHEREYE_NO_GPU</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" Condition="'$(Win7)' != 'true'" />
    <PackageReference Include="LibHeif.Native.win-x64" Version="1.15.1" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Compile Remove="PluginSdk\**" />
    <Compile Remove="plugins-samples\**" />
    <Resource Include="Assets\icon.ico" />
    <None Include="thirdparty\libraw22\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="thirdparty\librawhe\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PluginSdk\ImgViewer.Plugin.Abstractions.csproj" />
    <!-- Built together with the app so the bundled sample plugins are never stale; not referenced by the app code. -->
    <ProjectReference Include="plugins-samples\ImgViewer.Plugins.Samples.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <PluginSamplesBin>plugins-samples\bin\$(Configuration)\netstandard2.0\</PluginSamplesBin>
  </PropertyGroup>

  <Target Name="CopyLibRaw22ToPublish" AfterTargets="Publish">
    <Copy SourceFiles="thirdparty\libraw22\dcraw_emu.exe;thirdparty\libraw22\libraw.dll" DestinationFolder="$(PublishDir)thirdparty\libraw22" SkipUnchangedFiles="true" />
    <Copy SourceFiles="thirdparty\librawhe\dcraw_emu.exe" DestinationFolder="$(PublishDir)thirdparty\librawhe" SkipUnchangedFiles="true" />
  </Target>

  <!-- Sample plugins ship as an installed package folder: plugins\samples\{manifest.json, ImgViewer.Plugins.Samples.dll}. -->
  <Target Name="CopyPluginSamplesToPublish" AfterTargets="Publish">
    <ItemGroup Condition="Exists('$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll')">
      <PluginSampleBin Include="$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll;plugins-samples\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginSampleBin)" DestinationFolder="$(PublishDir)plugins\samples" SkipUnchangedFiles="true" Condition="@(PluginSampleBin->Count()) &gt; 0" />
    <Delete Files="$(PublishDir)plugins\ImgViewer.Plugins.Samples.dll" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPluginSamplesToOutput" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll')">
      <PluginSampleBin Include="$(PluginSamplesBin)ImgViewer.Plugins.Samples.dll;plugins-samples\manifest.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginSampleBin)" DestinationFolder="$(OutDir)plugins\samples" SkipUnchangedFiles="true" Condition="@(PluginSampleBin->Count()) &gt; 0" />
    <Delete Files="$(OutDir)plugins\ImgViewer.Plugins.Samples.dll" ContinueOnError="true" />
  </Target>

</Project>
